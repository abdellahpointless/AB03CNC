{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard when using Git deploys.
  "name": "cnc-process-pro",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    // Vite builds the React app into ./dist; the Worker only runs for /api/*.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cnc-process-pro-db",
      "database_id": "6a1444c9-c30a-44ff-aba0-7b097a8b088e"
    }
  ]
}
