diff --git a/src/lib/auditText.ts b/src/lib/auditText.ts
new file mode 100644
index 0000000..c367670
--- /dev/null
+++ b/src/lib/auditText.ts
@@ -0,0 +1,63 @@
+import i18n from '../i18n';
+
+/*
+ * A security log entry's detail in the page's language. The server records it in English
+ * ("password", "ali (MACHINIST)", "toolpath on", "POST /tr/api/parts/review"); anything not known
+ * here is shown as recorded.
+ */
+
+// Keys are built from the recorded text, so typed as one known key (as in toolExcelParse.ts).
+const t = (key: string, options?: Record<string, unknown>) => i18n.t(`app:users.log.${key}` as 'app:users.log.detail.role', options ?? {});
+const role = (r: string) => (i18n.exists(`common:role.${r}`) ? i18n.t(`common:role.${r}` as 'common:role.ADMIN') : r);
+
+/** Recorded phrase -> its key under users.log.detail. */
+const PHRASES: Record<string, string> = {
+  password: 'password',
+  totp: 'totp',
+  'recovery code': 'recoveryCode',
+  'account locked': 'locked',
+  locked: 'locked',
+  'IP throttled (unknown usernames)': 'ipThrottled',
+  'password reset': 'passwordReset',
+  'two-step sign-in reset': 'mfaReset',
+  'toolpath beta on': 'toolpathBetaOn',
+  'toolpath beta off': 'toolpathBetaOff',
+};
+/** The switches a country's admins know about; any other is left out of their log. */
+const FEATURES = ['partTracking', 'preventive', 'shiftChecks', 'toolpath'];
+/** The API area of an admin change (/api/<area>/...). */
+const AREAS = ['fleet', 'machines', 'tools', 'parts', 'history', 'settings', 'admin', 'toolpath', 'alerts'];
+
+function phrase(p: string): string {
+  const r = /^role -> (\w+)$/.exec(p);
+  if (r) return t('detail.role', { role: role(r[1]) });
+  return PHRASES[p] ? t(`detail.${PHRASES[p]}`) : p;
+}
+
+export function auditDetail(action: string, detail: string | null): string {
+  if (!detail) return '';
+  switch (action) {
+    case 'features_changed':
+      return detail
+        .split(', ')
+        .map((c) => /^(\w+) (on|off)$/.exec(c))
+        .filter((m): m is RegExpExecArray => !!m && FEATURES.includes(m[1]))
+        .map((m) => t(m[2] === 'on' ? 'detail.featureOn' : 'detail.featureOff', { feature: t(`feature.${m[1]}`) }))
+        .join(', ');
+    case 'user_created': {
+      const m = /^(.*) \((\w+)\)$/.exec(detail);
+      return m ? `${m[1]} (${role(m[2])})` : detail;
+    }
+    case 'user_updated': {
+      const i = detail.indexOf(': ');
+      return i < 0 ? detail : `${detail.slice(0, i)}: ${detail.slice(i + 2).split(', ').map(phrase).join(', ')}`;
+    }
+    case 'admin_action':
+    case 'admin_denied': {
+      const area = /\/api\/([a-z-]+)/.exec(detail)?.[1];
+      return area && AREAS.includes(area) ? t(`area.${area}`) : detail;
+    }
+    default:
+      return phrase(detail);
+  }
+}
diff --git a/tests/auditText.test.ts b/tests/auditText.test.ts
new file mode 100644
index 0000000..170ba65
--- /dev/null
+++ b/tests/auditText.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from 'vitest';
+import i18n from '../src/i18n';
+import { auditDetail } from '../src/lib/auditText';
+
+describe('security log details', () => {
+  it('are written in the page language, not as recorded codes and API paths', async () => {
+    await i18n.changeLanguage('tr');
+    try {
+      expect(auditDetail('login', 'password')).toBe('şifre ile');
+      expect(auditDetail('user_created', 'h4op (MACHINIST)')).toBe(`h4op (${i18n.t('common:role.MACHINIST')})`);
+      expect(auditDetail('user_updated', 'h4tmp: password reset')).toBe('h4tmp: şifre sıfırlandı');
+      expect(auditDetail('user_updated', 'ali: role -> ADMIN, two-step sign-in reset')).toBe(
+        `ali: rol: ${i18n.t('common:role.ADMIN')}, iki adımlı doğrulama sıfırlandı`,
+      );
+      expect(auditDetail('features_changed', 'toolpath on, preventive off')).toBe('Takım yolu görüntüleyici açıldı, Önleyici bakım kapatıldı');
+      expect(auditDetail('admin_action', 'POST /tr/api/parts/review')).toBe('Parçalar');
+      expect(auditDetail('admin_action', 'PUT /tr/api/machines/HAAS-1/owners')).toBe('Önleyici bakım');
+    } finally {
+      await i18n.changeLanguage('en');
+    }
+  });
+
+  it('leaves out a switch the country does not know, and shows anything unknown as recorded', () => {
+    expect(auditDetail('features_changed', 'newSwitch on, toolpath off')).toBe('Toolpath viewer switched off');
+    expect(auditDetail('features_changed', 'newSwitch on')).toBe('');
+    expect(auditDetail('admin_action', 'POST /ma/api/something-new')).toBe('POST /ma/api/something-new');
+    expect(auditDetail('login', 'totp')).toBe('with a 2-step code');
+    expect(auditDetail('user_deleted', 'karim')).toBe('karim');
+    expect(auditDetail('login', null)).toBe('');
+  });
+});
