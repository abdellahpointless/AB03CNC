Date: Fri, 27 Nov 2026 00:02:46 +0000
Subject: [PATCH] CAM AI: a pocket with straight walls and small rounded
 corners is no hole (a wall must be round along its edges too); the check adds
 up its cuts into the part (finding H6-2)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01YVyxNm2Fwb8M6A8TiczcwA
---
 src/lib/cam/features.ts   |  8 +++++++-
 src/lib/cam/program.ts    |  4 ++--
 tests/camFeatures.test.ts | 12 ++++++++++++
 tests/camSafety.test.ts   |  9 +++++++++
 4 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/src/lib/cam/features.ts b/src/lib/cam/features.ts
index d20a664..e9d049d 100644
--- a/src/lib/cam/features.ts
+++ b/src/lib/cam/features.ts
@@ -134,11 +134,17 @@ export function cylinders(P: Float32Array): { c: [number, number]; r: number; lo
     const r = Math.sqrt(Math.max(0, cx * cx + cy * cy - sol[2]));
     if (!(r > 0.1)) continue;
     let err = 0;
+    // Round along its edges too, not only at its corners: a square pocket's rounded corners lie near one circle, its
+    // straight walls (long chords of it) do not. A facet's middle bows 6 % of r in on the coarsest mesh of a hole this
+    // patch takes (9 sides); a straight wall between small rounded corners 18 % or more.
+    let bow = 0;
     let concave = 0;
     for (const t of list) {
       for (let c = 0; c < 3; c++) {
         const i = t * 9 + c * 3;
+        const j = t * 9 + ((c + 1) % 3) * 3;
         err = Math.max(err, Math.abs(Math.hypot(P[i] - cx, P[i + 1] - cy) - r));
+        bow = Math.max(bow, r - Math.hypot((P[i] + P[j]) / 2 - cx, (P[i + 1] + P[j + 1]) / 2 - cy));
       }
       // A hole's walls face its axis (the material is outside).
       const i = t * 9;
@@ -146,7 +152,7 @@ export function cylinders(P: Float32Array): { c: [number, number]; r: number; lo
       const my = (P[i + 1] + P[i + 4] + P[i + 7]) / 3 - cy;
       concave += normals[t][0] * mx + normals[t][1] * my < 0 ? 1 : -1;
     }
-    if (err > Math.max(0.02, r * 0.03)) continue;
+    if (err > Math.max(0.02, r * 0.03) || bow > Math.max(0.02, r * 0.08)) continue;
     out.push({ c: [cx, cy], r, lo, hi, concave: concave > 0, closed: widest < (50 * Math.PI) / 180, err });
   }
   return out;
diff --git a/src/lib/cam/program.ts b/src/lib/cam/program.ts
index 86aca43..2dace3d 100644
--- a/src/lib/cam/program.ts
+++ b/src/lib/cam/program.ts
@@ -1718,8 +1718,8 @@ function overParallels(code: string, speeds: MachineSpeeds): string {
   return lines.join('\n');
 }
 
-/** The largest piece cut out of the part that the model keeps (mm³): an overcut. */
-export const gougeOf = (c: CamCheck) => Math.round(Math.max(0, ...c.pieces.filter((p) => p.kind === 'cut').map((p) => p.mm3)));
+/** All the pieces cut out of the part that the model keeps, added up (mm³): an overcut (four small ones are one bad part). */
+export const gougeOf = (c: CamCheck) => Math.round(c.pieces.reduce((t, p) => t + (p.kind === 'cut' ? p.mm3 : 0), 0));
 
 /**
  * The program for a part: planned with each of its sides as the height in the vise (thinnest
