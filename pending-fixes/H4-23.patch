diff --git a/src/components/AdminExtractionAnalytics.tsx b/src/components/AdminExtractionAnalytics.tsx
index 9cd4f9b..191e339 100644
--- a/src/components/AdminExtractionAnalytics.tsx
+++ b/src/components/AdminExtractionAnalytics.tsx
@@ -569,7 +569,7 @@ export default function AdminExtractionAnalytics() {
                         <div
                           className="h-full rounded-full transition-all duration-500"
