diff --git a/src/i18n/format.ts b/src/i18n/format.ts
index 9cb3ca9..0af0c03 100644
--- a/src/i18n/format.ts
+++ b/src/i18n/format.ts
@@ -33,6 +33,11 @@ export function fmtNumber(n: number | null | undefined, maxFractionDigits = 2):
   return n.toLocaleString(locale(), { maximumFractionDigits: maxFractionDigits });
 }
 
+/** 0.23 -> "23%" / "%23" (Turkish puts the sign first). */
+export function fmtPercent(fraction: number, maxFractionDigits = 0): string {
+  return Number.isFinite(fraction) ? fraction.toLocaleString(locale(), { style: 'percent', maximumFractionDigits: maxFractionDigits }) : '-';
+}
+
 /** "2026-10" -> "October 2026" / "Ekim 2026" (or the short form "Oct 2026" / "Eki 2026"). */
 export function fmtMonth(monthKey: string, short = false): string {
   const m = /^(\d{4})-(\d{2})$/.exec(monthKey);
diff --git a/tests/fmtPercent.test.ts b/tests/fmtPercent.test.ts
new file mode 100644
index 0000000..5644ee9
--- /dev/null
+++ b/tests/fmtPercent.test.ts
@@ -0,0 +1,16 @@
+import { describe, expect, it } from 'vitest';
+import i18n from '../src/i18n';
+import { fmtPercent } from '../src/i18n/format';
+
+describe('percent in the page language', () => {
+  it('writes 23% in English and %23 in Turkish', async () => {
+    expect(fmtPercent(0.234)).toBe('23%');
+    await i18n.changeLanguage('tr');
+    try {
+      expect(fmtPercent(0.234)).toBe('%23');
+      expect(fmtPercent(Number.NaN)).toBe('-');
+    } finally {
+      await i18n.changeLanguage('en');
+    }
+  });
+});
