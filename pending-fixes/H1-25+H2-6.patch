From fa368d381ed6406d90e503123fbbb1de9cd1ed60 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 00:36:53 +0000
Subject: [PATCH] CAM AI: header fits from 800 px, the time chip only with the
 inspector open, Send its icon alone under 1100 px (findings H1-25, H2-6)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The ⋯ menu no longer shrinks or leaves the window; the file name keeps room.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01YVyxNm2Fwb8M6A8TiczcwA
---
 src/components/CamAi.tsx | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/components/CamAi.tsx b/src/components/CamAi.tsx
index 5ce0d57..5662e01 100644
--- a/src/components/CamAi.tsx
+++ b/src/components/CamAi.tsx
@@ -1585,7 +1585,8 @@ export default function CamAi({ onSend, onExit }: { onSend: (code: string, fileN
           </Popover.Portal>
         </Popover.Root>
         <span className="flex-1" />
-        {result && (
+        {/* Under 1400 px the Inspector button takes its place (the header would overflow). */}
+        {result && wide && (
           <span className="hidden xl:inline-flex shrink-0 whitespace-nowrap items-center gap-1.5 px-2 text-xs text-[var(--text-secondary)] tabular-nums" title={t('camAi.ws.timeChip', { min: fmt(result.minutes, 0), n: result.toolChanges })}>
             <Clock size={15} stroke={1.6} aria-hidden />
             {t('camAi.ws.timeChip', { min: fmt(result.minutes, 0), n: result.toolChanges })}
@@ -1600,8 +1601,9 @@ export default function CamAi({ onSend, onExit }: { onSend: (code: string, fileN
           <Download size={16} stroke={1.6} aria-hidden /> {t('camAi.download')}
         </button>
         {result ? (
-          <button type="button" className="btn-primary h-8 px-3.5 text-[13px] shrink-0 whitespace-nowrap inline-flex items-center gap-2" onClick={() => result && ok && !waiting && machine && onSend(result.code, fileName, machine.id)} disabled={!ok || busy || checking || waiting} title={waiting ? t('camAi.makeFirst') : ok ? undefined : t('camAi.locked')}>
-            <Send size={16} stroke={1.8} aria-hidden /> {t('camAi.send')}
+          <button type="button" className="btn-primary h-8 px-3.5 text-[13px] shrink-0 whitespace-nowrap inline-flex items-center gap-2" onClick={() => result && ok && !waiting && machine && onSend(result.code, fileName, machine.id)} disabled={!ok || busy || checking || waiting} title={waiting ? t('camAi.makeFirst') : ok ? t('camAi.send') : t('camAi.locked')}>
+            {/* Its icon alone under 1100 px (the tools a drawer), so the ⋯ menu and the file name keep their room. */}
+            <Send size={16} stroke={1.8} aria-hidden /> <span className="sr-only min-[1100px]:not-sr-only">{t('camAi.send')}</span>
           </button>
         ) : run.state === 'busy' ? (
           <button type="button" className={barBtn} onClick={stop}>
@@ -1614,7 +1616,7 @@ export default function CamAi({ onSend, onExit }: { onSend: (code: string, fileN
         )}
         <Popover.Root>
           <Popover.Trigger asChild>
-            <button type="button" className="no-glass w-8 h-8 grid place-items-center rounded-[8px] border border-[var(--border-subtle)] text-[var(--text-primary)] hover:bg-[rgba(var(--ov),0.08)]" aria-label={t('camAi.ws.more')} title={t('camAi.ws.more')}>
+            <button type="button" className="no-glass w-8 h-8 shrink-0 grid place-items-center rounded-[8px] border border-[var(--border-subtle)] text-[var(--text-primary)] hover:bg-[rgba(var(--ov),0.08)]" aria-label={t('camAi.ws.more')} title={t('camAi.ws.more')}>
               <Dots size={18} stroke={1.8} aria-hidden />
             </button>
           </Popover.Trigger>
