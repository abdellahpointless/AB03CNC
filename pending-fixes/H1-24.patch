From 9fd3a93e0e93cd7819c6d9ef22b0b1d60e37daae Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 00:43:21 +0000
Subject: [PATCH] CAM AI: the changed-by-hand box counts with plurals, says
 when tools were moved, "differs" only when the part does; the lock note once
 in the Program panel (finding H1-24)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01YVyxNm2Fwb8M6A8TiczcwA
---
 src/components/CamAi.tsx       |  8 +++++++-
 src/components/CamAiResult.tsx | 19 +++++++++++--------
 src/i18n/locales/en/cam.ts     |  6 +++++-
 src/i18n/locales/tr/cam.ts     |  6 +++++-
 4 files changed, 28 insertions(+), 11 deletions(-)

diff --git a/src/components/CamAi.tsx b/src/components/CamAi.tsx
index fb2acd9..3c23535 100644
--- a/src/components/CamAi.tsx
+++ b/src/components/CamAi.tsx
@@ -1351,7 +1351,13 @@ export default function CamAi({ onSend, onExit }: { onSend: (code: string, fileN
 
             {result && handEdited && (
               <section className="space-y-1.5 rounded-[var(--radius-md)] border border-[var(--accent-primary)]/40 p-2.5" aria-live="polite">
-                <p className="text-[var(--text-primary)]">{t('camAi.opEdit.changed', { count: Object.keys(opEdits).length, pct: fmt(result.match * 100, 1), mm3: fmt(result.gouge, 0) })}</p>
+                <p className="text-[var(--text-primary)]">
+                  {[
+                    Object.keys(opEdits).length ? t('camAi.opEdit.changed', { count: Object.keys(opEdits).length }) : '',
+                    Object.values(opOrder).some((c) => c.length > 0) ? t('camAi.opEdit.moved') : '',
+                    alike(result) ? t('camAi.opEdit.alike', { pct: fmt(result.match * 100, 1) }) : t('camAi.opEdit.differs', { pct: fmt(result.match * 100, 1), mm3: fmt(result.gouge, 0) }),
+                  ].filter(Boolean).join(' ')}
+                </p>
                 {safeButHold(result) && (!alike(result) || result.misplaced > 0) && (
                   <label className="flex items-center gap-2 min-h-9 text-[var(--text-primary)]">
                     <input type="checkbox" checked={accepted} onChange={(e) => setAccepted(e.target.checked)} />
diff --git a/src/components/CamAiResult.tsx b/src/components/CamAiResult.tsx
index 9b366f1..b4e1edc 100644
--- a/src/components/CamAiResult.tsx
+++ b/src/components/CamAiResult.tsx
@@ -224,14 +224,17 @@ export function ProgramPanel({
           </button>
         </div>
       ))}
-      {result.notes.length > 0 && (
-        <ul className="text-xs text-[var(--text-secondary)] list-disc pl-4 space-y-0.5">
-          {result.notes.map((n, i) => {
-            const { key, ...v } = n;
-            return <li key={i}>{t(`camAi.note.${key}`, v)}</li>;
-          })}
-        </ul>
-      )}
+      {(() => {
+        // The notes, but the one the verdict at the top already says.
+        const notes = result.notes.map(({ key, ...v }) => t(`camAi.note.${key}`, v)).filter((n) => n !== text);
+        return (
+          notes.length > 0 && (
+            <ul className="text-xs text-[var(--text-secondary)] list-disc pl-4 space-y-0.5">
+              {notes.map((n, i) => <li key={i}>{n}</li>)}
+            </ul>
+          )
+        );
+      })()}
     </div>
   );
 }
