diff --git a/tests/trCales.test.ts b/tests/trCales.test.ts
new file mode 100644
index 0000000..5e9497c
--- /dev/null
+++ b/tests/trCales.test.ts
@@ -0,0 +1,11 @@
+import { readFileSync, readdirSync } from 'node:fs';
+import { describe, expect, it } from 'vitest';
+
+// Turkish calls cales 'paralel' (Preventive actions, Cales stock, phone check); 'kale' is a castle.
+describe('Turkish word for cales', () => {
+  it('is paralel in the Turkish texts and What’s new', () => {
+    const files = [...readdirSync('src/i18n/locales/tr').filter((f) => f !== 'cam.ts').map((f) => `src/i18n/locales/tr/${f}`), 'src/lib/whatsNew.ts'];
+    const found = files.flatMap((f) => (readFileSync(f, 'utf8').match(/\bkale(?![mç])\w*/gi) ?? []).map((w) => `${f}: ${w}`));
+    expect(found).toEqual([]);
+  });
+});
