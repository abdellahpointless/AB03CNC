---
 src/lib/preventiveReport.ts    |  3 ++-
 tests/preventiveReport.test.ts | 13 +++++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)
 create mode 100644 tests/preventiveReport.test.ts

diff --git a/src/lib/preventiveReport.ts b/src/lib/preventiveReport.ts
index 81eb22f..edc5ceb 100644
--- a/src/lib/preventiveReport.ts
+++ b/src/lib/preventiveReport.ts
@@ -28,7 +28,8 @@ export function reportRows(data: MachinesReport, nameOf: (id: string) => string,
     at: e.at,
     machine: nameOf(e.machine_id),
     kind: e.action,
-    details: e.action === 'PROBLEM' ? [e.check_title, e.note].filter(Boolean).join(' · ') : e.check_title ?? e.note ?? '',
+    // A problem with the machine itself stores its text as both title and note: once.
+    details: e.action === 'PROBLEM' ? [...new Set([e.check_title, e.note].filter(Boolean))].join(' · ') : e.check_title ?? e.note ?? '',
     notDoneBy: e.action === 'MISSED' ? e.note ?? '' : '',
     by: e.username,
   }));
diff --git a/tests/preventiveReport.test.ts b/tests/preventiveReport.test.ts
new file mode 100644
index 0000000..039fce8
--- /dev/null
+++ b/tests/preventiveReport.test.ts
@@ -0,0 +1,13 @@
+import { describe, expect, it } from 'vitest';
+import { reportRows } from '../src/lib/preventiveReport';
+import type { MachinesReport } from '../src/lib/fleet';
+
+const report = (events: MachinesReport['events']): MachinesReport => ({ events, cales: [], people: [], hidden: [], truncated: false, machines: [], taken: [] });
+const ev = (check_title: string | null, note: string | null) => ({ machine_id: 'HAAS-1', check_title, action: 'PROBLEM' as const, note, username: 'ali', at: 1 });
+
+describe('report rows', () => {
+  it('writes a problem text once when title and note are the same (a problem with the machine itself)', () => {
+    const rows = reportRows(report([ev('Spindle noise', 'Spindle noise'), ev('Coolant', 'Level low'), ev('Coolant', null)]), (id) => id, () => '');
+    expect(rows.map((r) => r.details)).toEqual(['Spindle noise', 'Coolant · Level low', 'Coolant']);
+  });
+});
